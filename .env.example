# Optional server-only OpenAI key. Leave blank for manual wall/placement tools.
# Enter a real value only in your local .env or secure hosting settings; never commit it.
AC_OPENAI_API_KEY=
# Vision-capable model used for optional AI wall detection and placement.
AC_OPENAI_MODEL=gpt-4.1-mini
# Docker: local browser port. Change this if 3001 is already in use.
LIVEAC_PORT=3001
# Docker listens only on your PC by default. See README for optional LAN access.
LIVEAC_BIND_ADDRESS=127.0.0.1
# Non-Docker production/API HTTP port. Docker always uses 3001 internally.
PORT=3001

# CPU segmentation worker threads (default 2; tune for your server).
WALL_CPU_THREADS=2
# Optional non-Docker model path; Docker bundles the verified model automatically.
# WALL_MODEL_PATH=models/wall-segmentation-int8.onnx
