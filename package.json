{
  "name": "liveac-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --use-env-proxy --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --import tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "build:local": "npm run build && node scripts/package-standalone.mjs",
    "build:pages": "npm run build && node scripts/package-standalone.mjs --hosted",
    "model:fetch": "node --use-env-proxy scripts/fetch-wall-model.mjs",
    "benchmark:wall": "node --import tsx scripts/benchmark-wall.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^0.577.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
